# EmbyBox 配置示例
#
# 复制为 .env 后修改。.env 已在 .gitignore 里，不会被提交。
#
#   cp .env.example .env
#
# 所有变量前缀为 EMBYBOX_。

# ─────────────────────────────────────────────
# 服务
# ─────────────────────────────────────────────

# 监听地址
EMBYBOX_HTTP_ADDR=:8080

# 对外访问地址，用于生成回调链接。配了域名后必须改这里
EMBYBOX_BASE_URL=http://localhost:8080

# 业务时区。所有"今天""到期日""签到周期"都按它计算
# 改了它会影响到期判定与周期统计，请与运营地区一致
EMBYBOX_TIMEZONE=Asia/Shanghai

# 是否信任 X-Forwarded-For
# ⚠️ 部署在 Nginx/Caddy 后面时必须设为 true，否则限流会把所有请求当成来自反代 IP
# ⚠️ 没走反代时保持 false，否则攻击者可伪造 IP 绕过限流
EMBYBOX_TRUST_PROXY=false

# Prometheus 指标端口，留空表示不开启
EMBYBOX_METRICS_ADDR=

# ─────────────────────────────────────────────
# 数据库
# ─────────────────────────────────────────────

# sqlite 或 postgres
EMBYBOX_DB_DRIVER=sqlite

# SQLite 时是文件路径；PostgreSQL 时是连接串
EMBYBOX_DB_DSN=./data/embybox.db
# EMBYBOX_DB_DSN=postgres://user:pass@127.0.0.1:5432/embybox?sslmode=disable

# ─────────────────────────────────────────────
# 安全
# ─────────────────────────────────────────────

# ⚠️ 主密钥，至少 32 字节。用于会话签名与凭据加密
# ⚠️ 必须单独安全备份 —— 丢了就解不开已加密的 API Key
# 生成方式：
#   Linux/macOS:  head -c 32 /dev/urandom | base64
#   PowerShell:   [Convert]::ToBase64String((1..32 | %{Get-Random -Max 256}))
EMBYBOX_SECRET_KEY=

# 会话有效期
EMBYBOX_SESSION_TTL=72h

# 首次启动时创建的管理员
# ⚠️ ADMIN_PASS 留空会拒绝启动（这是刻意的：空密码 + 公网 = 靶子）
# 首次登录后请立刻修改
EMBYBOX_ADMIN_USER=admin
EMBYBOX_ADMIN_PASS=

# 是否在启动时补齐种子数据
EMBYBOX_SEED_ON_BOOT=true

# 额外信任的代理网段（CIDR，逗号分隔）。TRUST_PROXY=true 时生效
# EMBYBOX_TRUSTED_NETS=172.16.0.0/12,10.0.0.0/8

# ─────────────────────────────────────────────
# 日志
# ─────────────────────────────────────────────

# debug / info / warn / error
EMBYBOX_LOG_LEVEL=info

# text（人读）或 json（机器采集，生产建议）
EMBYBOX_LOG_FORMAT=text

# ─────────────────────────────────────────────
# 插件
# ─────────────────────────────────────────────

# 插件搜索目录，逗号分隔
EMBYBOX_PLUGIN_DIRS=./plugins

# 显式禁用的插件 ID，逗号分隔
# EMBYBOX_DISABLED_PLUGINS=

# ─────────────────────────────────────────────
# 数据
# ─────────────────────────────────────────────

# 数据目录（上传、备份、插件数据）
EMBYBOX_DATA_DIR=./data
