# ── 第三方参考项目 ───────────────────────────────
# 15 个生态内项目的完整 git 历史，约 170 MB，各自许可证独立。
# 用 ./scripts/fetch-references.sh 拉取。
参考项目/

# ── 运行期数据 ───────────────────────────────────
data/
*.db
*.db-wal
*.db-shm

# ── 配置（可能含密钥）───────────────────────────
.env
.env.local
.env.*.local

# ── 构建产物 ─────────────────────────────────────
/embybox
/embybox-*
/dist/
web/dist/

# ── 依赖 ─────────────────────────────────────────
node_modules/
web/node_modules/

# ── 编辑器与系统 ─────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ── 临时文件 ─────────────────────────────────────
*.log
*.tmp
coverage.out
coverage.html
